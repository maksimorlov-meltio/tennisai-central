# ── Frontend (Vite) ─────────────────────────────────────
# Absolute base URL of the API, INCLUDING the /api suffix. Leave BLANK for local
# dev — the Vite dev server proxies /api to http://localhost:4000 (vite.config.ts).
# In production this MUST be set to the deployed API origin, e.g.
#   VITE_API_BASE_URL=https://tennisai-api.onrender.com/api
VITE_API_BASE_URL=

# IMPORTANT: Vite inlines this at BUILD time. Setting it in a hosting dashboard
# after a build has already run has no effect — redeploy so it is rebuilt.

# Use the in-memory mock auth instead of the real backend (frontend-only dev).
# MUST be unset in a production build, or nobody reaches the real API.
# VITE_MOCK_AUTH=true

# Force the connections feature to stay in browser memory even with an API
# configured. Local dev and tests only — leave unset in production.
# VITE_USE_MOCK_CONNECTIONS=true

# ── Production build (e.g. Vercel project settings) ─────
# Set ONLY the first variable. Everything else above stays unset:
#   VITE_API_BASE_URL=https://<your-api-host>/api
#
# Sanity check after building — the bundle should contain your API host:
#   grep -l "<your-api-host>" dist/assets/*.js
# No match means the variable was missing at build time, and the app is calling
# a /api path that does not exist on the static host.

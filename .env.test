# Test environment (safe to commit — no secrets, flags only).
# Vitest runs in "test" mode, so Vite loads this OVER .env. It pins the
# in-memory mock defaults the suite is written against, so `npm test` is
# deterministic whether the dev .env is in mock OR real-backend mode.
VITE_MOCK_AUTH=true
VITE_API_BASE_URL=

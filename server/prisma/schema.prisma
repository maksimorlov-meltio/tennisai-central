// TennisAI database schema.
// Provider is PostgreSQL — the same engine is used in dev and production
// (dev/prod parity). For local dev, run a Postgres via `docker compose up -d`
// (see server/docker-compose.yml) and point DATABASE_URL at it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  publicId                String    @unique // shareable directory id, e.g. TAI-P-001
  passwordHash            String
  role                    String // "player" | "coach" | "observer" | "admin"
  firstName               String
  lastName                String
  emailVerified           Boolean   @default(false)
  onboarding              Json? // role-based onboarding answers (see src/lib/onboarding)
  onboardingCompletedAt   DateTime? // set when the user finishes the intro questionnaire
  termsAcceptedAt         DateTime? // set at signup when the user accepts the Terms of Service
  ageConfirmedAt          DateTime? // set at signup when the user confirms the age requirement
  // Date of birth as ISO "yyyy-MM-dd". Held on User, not only on PlayerProfile,
  // because the minor check runs at signup — before any profile exists, and for
  // every role, not just players.
  dateOfBirth             String?
  // Guardian consent, for accounts below the age of digital consent.
  // The threshold is configurable (MINOR_AGE_THRESHOLD) rather than hardcoded:
  // GDPR leaves it to member states and it ranges from 13 to 16 — Spain 14,
  // Germany 16 — so a single baked-in number is wrong somewhere by design.
  // An account with guardianEmail set and guardianConsentAt null exists but
  // cannot sign in.
  // The gate itself, as one explicit flag rather than a rule derived from two
  // nullable columns. Set at signup when the date of birth is below the
  // threshold; login refuses while it is true and guardianConsentAt is null.
  // Derived rules ("guardianEmail is set, so...") are the kind that quietly
  // stop firing when an unrelated field changes shape.
  guardianConsentRequired Boolean   @default(false)
  guardianEmail           String?
  guardianName            String?
  guardianConsentAt       DateTime?
  guardianConsentToken    String?   @unique
  guardianConsentSentAt   DateTime?
  // Bumped on every password change. A password-reset token issued BEFORE this
  // timestamp is rejected, which makes reset links effectively single-use.
  passwordChangedAt       DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // back-relations (trainings domain)
  coachedTrainings         Training[]              @relation("TrainingCoach")
  trainingParticipations   TrainingParticipant[]
  // back-relations (tournaments domain)
  playerTournaments        PlayerTournament[]
  hiddenTournaments        HiddenTournament[]
  // back-relations (teams domain)
  coachedTeams             Team[]                  @relation("TeamCoach")
  teamMemberships          TeamMember[]
  // back-relations (connections domain)
  sentConnections          ConnectionRequest[]     @relation("ConnFrom")
  receivedConnections      ConnectionRequest[]     @relation("ConnTo")
  // back-relations (training-requests domain)
  trainingRequestsAsPlayer TrainingRequest[]       @relation("TRPlayer")
  trainingRequestsAsCoach  TrainingRequest[]       @relation("TRCoach")
  // back-relations (finance / equipment / notifications)
  financeEntries           FinanceEntry[]
  equipmentItems           EquipmentItem[]
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  calendarPreference       CalendarPreference?
  pushSubscriptions        PushSubscription[]

  // back-relations (analytics domain — Stage 1, additive)
  profile                 PlayerProfile?     @relation("UserProfile")
  coachNotesAuthored      PrivateCoachNote[] @relation("CoachNoteAuthor")
  coachNotesAbout         PrivateCoachNote[] @relation("CoachNoteSubject")
  ownedOpponents          Opponent[]         @relation("OpponentOwner")
  matches                 Match[]            @relation("MatchPlayer")
  scoutingReportsCreated  ScoutingReport[]   @relation("ScoutingCreatedBy")
  gamePlansAsPlayer       GamePlan[]         @relation("GamePlanPlayer")
  gamePlansCreated        GamePlan[]         @relation("GamePlanCreatedBy")
  postMatchReportsCreated PostMatchReport[]  @relation("PostMatchCreatedBy")
  trainingPlansAsPlayer   TrainingPlan[]     @relation("TrainingPlanPlayer")
  trainingPlansCreated    TrainingPlan[]     @relation("TrainingPlanCreatedBy")
  aiGenerations           AiGeneration[]     @relation("AiGenUser")
  subscription            Subscription?      @relation("SubscriptionOwner")
  aiUsageCounters         AiUsageCounter[]   @relation("AiUsageUser")

  // back-relations (roles & tenancy — Stage 2, additive)
  academyMemberships       AcademyMembership[] @relation("AcademyMemberUser")
  coachAssignmentsAsCoach  CoachAssignment[]   @relation("AssignmentCoach")
  coachAssignmentsAsPlayer CoachAssignment[]   @relation("AssignmentPlayer")
  guardianshipsAsGuardian  Guardianship[]      @relation("GuardianshipGuardian")
  guardianshipsAsJunior    Guardianship[]      @relation("GuardianshipJunior")

  // back-relations (coaching knowledge base — additive)
  ownedDrills               Drill[]            @relation("DrillOwnerCoach")
  generatedSessionsAsCoach  GeneratedSession[] @relation("GeneratedSessionCoach")
  generatedSessionsAsPlayer GeneratedSession[] @relation("GeneratedSessionPlayer")
  coachPreferences          CoachPreference[]  @relation("CoachPreferenceCoach")
  // back-relations (gear domain — additive)
  stringSetups StringSetup[] @relation("StringSetupPlayer")

  @@map("users")
}

// ── Trainings domain ─────────────────────────────────────────────
// Mirrors the front-end `TrainingSession` shape (src/types/index.ts).
// `playerIds[]` is normalised into the TrainingParticipant join table.
// The nested review / feedback / analysis objects are stored as JSON.

model Training {
  id                    String   @id @default(cuid())
  title                 String
  description           String?
  trainingType          String // individual | team | match_practice | fitness | recovery | tactical
  coachId               String
  teamId                String? // FK relation added when the teams domain migrates
  startDate             DateTime
  endDate               DateTime
  location              String?
  goal                  String?
  intensity             String? // low | medium | high
  notes                 String?
  coachNotes            String?
  review                Json? // TrainingReview
  playerSessionFeedback Json? // PlayerSessionFeedback
  analysis              Json? // TrainingAnalysis
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  coach        User                  @relation("TrainingCoach", fields: [coachId], references: [id], onDelete: Cascade)
  participants TrainingParticipant[]

  @@index([coachId])
  @@index([startDate])
  @@map("trainings")
}

model TrainingParticipant {
  id             String    @id @default(cuid())
  trainingId     String
  playerId       String
  createdAt      DateTime  @default(now())
  // Attendance lives on the join row, not on a separate model: a participant
  // IS the thing that attends, and a second table would allow a mark with no
  // matching participant. Null means "not yet marked", which is different from
  // "absent" and has to stay tellable apart — a coach who has not taken the
  // register yet is not a coach reporting an empty session.
  // "present" | "absent" | "late" | "excused"
  attendance     String?
  attendanceAt   DateTime?
  attendanceBy   String? // coach User id who took the register
  attendanceNote String?

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  player   User     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([trainingId, playerId])
  @@index([playerId])
  @@map("training_participants")
}

// ── Tournaments domain ───────────────────────────────────────────
// A global catalog (Tournament) plus a per-player join (PlayerTournament).
// Mirrors the front-end `Tournament` / `PlayerTournament` shapes.

model Tournament {
  id             String   @id @default(cuid())
  name           String
  city           String
  country        String
  surface        String
  indoorOutdoor  String // indoor | outdoor
  altitude       Int?
  ballBrand      String?
  weatherSummary String?
  category       String?
  level          String?
  federation     String? // ITF | WTA | ATP | UTR | USTA
  latitude       Float? // host-city latitude (decimal degrees) — powers the map + distance sort
  longitude      Float? // host-city longitude (decimal degrees)
  startDate      DateTime
  endDate        DateTime
  description    String?

  // ── What a coach needs before deciding to enter ──────────────────────────
  // The date entries close: the most time-critical fact about a tournament, and
  // the one most often missed. A perfect event found two days late is not an
  // option at all.
  entryDeadline   DateTime?
  // Age band ("U16", "18 & Under"), the venue, and the event's own page.
  ageCategory     String?
  venue           String?
  website         String?
  // How many players have entered so far — a rough read on field strength, and
  // on whether the draw will happen at all.
  registeredCount Int?

  // ── UTR band ─────────────────────────────────────────────────────────────
  // UTR events advertise the rating range they are aimed at. That is what makes
  // "will my player get matches at their level here" answerable, so it is kept
  // as numbers rather than the "1.0 - 16.0" string the feed sends.
  utrRangeMin Float?
  utrRangeMax Float?

  // ── Provenance ───────────────────────────────────────────────────────────
  // Which feed produced this row and when it was last seen there. A stale
  // lastSeenAt means the source stopped listing the event — cancelled, or the
  // scraper broke. Either way the app must not present it as current without
  // saying how old it is.
  source     String?
  sourceUrl  String?
  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  playerEntries  PlayerTournament[]
  hiddenBy       HiddenTournament[]
  // Costs booked against this event (gear domain — additive).
  financeEntries FinanceEntry[]

  @@index([startDate])
  @@index([federation, startDate])
  @@map("tournaments")
}

// A per-user "eliminate from suggestions" list. One row = this user hid this
// tournament. Owner-scoped in the routes; the row disappears (cascade) when
// either the user or the tournament is deleted.
model HiddenTournament {
  id           String   @id @default(cuid())
  userId       String
  tournamentId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
  @@index([userId])
  @@map("hidden_tournaments")
}

model PlayerTournament {
  id           String   @id @default(cuid())
  tournamentId String
  playerId     String
  status       String // planned | registered | maybe | withdrawn | played
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player     User       @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, playerId])
  @@index([playerId])
  @@map("player_tournaments")
}

// ── Teams domain ─────────────────────────────────────────────────
// A coach-owned team with player members. The front-end `Team.players`
// (ConnectedPlayer[]) is composed from the TeamMember join + User.

model Team {
  id        String   @id @default(cuid())
  name      String
  coachId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach   User         @relation("TeamCoach", fields: [coachId], references: [id], onDelete: Cascade)
  members TeamMember[]

  generatedSessions GeneratedSession[] @relation("GeneratedSessionTeam")

  @@index([coachId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  playerId String
  joinedAt DateTime @default(now()) // → ConnectedPlayer.connectedSince

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player User @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@index([playerId])
  @@map("team_members")
}

// ── Connections domain ───────────────────────────────────────────
// A directed relationship request between two users. Denormalised
// names/roles in the front-end shape are derived from the User join.

model ConnectionRequest {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  status     String   @default("pending") // pending | active | rejected | revoked
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fromUser User @relation("ConnFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("ConnTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
  @@index([status])
  @@map("connection_requests")
}

// ── Training-requests domain ─────────────────────────────────────
// A player's request to a coach for a session. On approval a calendar
// event is created and linked via calendarEventId.

model TrainingRequest {
  id                 String   @id @default(cuid())
  playerId           String
  coachId            String
  status             String   @default("pending") // pending | approved | rejected | reschedule_proposed | cancelled
  preferredDate      String // "yyyy-MM-dd"
  preferredStartTime String // "HH:mm"
  preferredEndTime   String
  trainingType       String
  location           String?
  notes              String?
  priority           String? // normal | high
  coachMessage       String?
  proposedDate       String?
  proposedStartTime  String?
  proposedEndTime    String?
  calendarEventId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  player User @relation("TRPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  coach  User @relation("TRCoach", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([coachId])
  @@index([status])
  @@map("training_requests")
}

// ── Calendar domain ──────────────────────────────────────────────
// Events with optional recurrence (stored as a rule; expanded into
// virtual occurrences on read). playerId/teamId/tournamentId are loose
// denormalised pointers, matching the front-end CalendarEvent shape.

model CalendarEvent {
  id                String   @id @default(cuid())
  title             String
  type              String // training | tournament | match | travel | recovery
  state             String?
  startDate         DateTime
  endDate           DateTime
  location          String?
  description       String?
  playerId          String?
  playerName        String?
  teamId            String?
  tournamentId      String?
  coachNotes        String?
  createdBy         String?
  createdByRole     String?
  trainingRequestId String?
  recurrence        Json? // RecurrenceRule
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdBy])
  @@index([playerId])
  @@index([startDate])
  @@map("calendar_events")
}

// ── Finance / Equipment / Notifications ──────────────────────────

model FinanceEntry {
  id           String   @id @default(cuid())
  playerId     String
  // Additive vocabulary — nothing was renamed, so every row already written
  // stays valid:
  //   training | travel | tournament | equipment            (original four)
  //   coaching | stringing | tournament_fee | accommodation
  //   food | membership | other                             (added, gear wave)
  category     String
  description  String
  amount       Float
  // Default changed USD → EUR for NEW rows only. Existing rows keep the
  // currency they were written with — the migration alters the column default
  // and never runs an UPDATE, because re-labelling a stored amount would
  // silently change what it means.
  currency     String   @default("EUR")
  date         String
  // Optional link to the event this cost belongs to. Without it, "what did
  // Roland Garros actually cost" has to be inferred from a date window, which
  // is wrong the moment a flight is booked two months early.
  tournamentId String?
  createdAt    DateTime @default(now())

  player     User        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  @@index([playerId])
  @@index([tournamentId])
  @@map("finance_entries")
}

model EquipmentItem {
  id           String   @id @default(cuid())
  playerId     String
  category     String
  name         String
  brand        String?
  model        String?
  notes        String?
  acquiredDate String?
  condition    String?
  // Optional link to the shared catalogue. Null means "the player typed this
  // in themselves and it matches nothing we carry" — a perfectly valid state,
  // so this is nullable and SetNull rather than a required foreign key. A
  // product being retired from the catalogue must never delete a player's own
  // record of the racket in their bag.
  productId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  player  User              @relation(fields: [playerId], references: [id], onDelete: Cascade)
  product EquipmentProduct? @relation("EquipmentItemProduct", fields: [productId], references: [id], onDelete: SetNull)

  // Every stringing this frame has been through.
  stringSetups StringSetup[] @relation("StringSetupRacket")

  @@index([playerId])
  @@index([productId])
  @@map("equipment_items")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean   @default(false)
  linkTo    String?
  createdAt DateTime  @default(now())
  // Set once this notification has been delivered by email, so a retry or a
  // scheduled sweep can never send the same notification twice.
  emailedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// What a user wants to SEE on their calendar.
//
// Separate from NotificationPreference because it answers a different question:
// that one is "what should reach me", this is "what should I be looking at".
//
// It exists because the calendar filters were session-only, and with the world's
// tournament feeds loaded a coach met 1,458 events in September and had to
// re-hide them on every single visit. Subscribing once is the whole point.
model CalendarPreference {
  id     String @id @default(cuid())
  userId String @unique

  // Federations the user has subscribed to, e.g. ["ITF", "UTR"].
  //
  // EMPTY IS MEANINGFUL and is the default: a new account sees its own sessions
  // and nothing else, then opts in. It deliberately does not mean "all" — that
  // was the old behaviour and is what made the calendar unreadable.
  federations String[] @default([])

  // Own trainings, matches and calendar events. Off means tournaments only.
  showOwnEvents Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_preferences")
}

model NotificationPreference {
  id                  String  @id @default(cuid())
  userId              String  @unique
  // Channel-level switches. The per-category flags below decide WHAT is worth
  // notifying about; these decide HOW it is delivered. Email/push are only ever
  // sent when the channel is enabled AND the category flag is on.
  emailEnabled        Boolean @default(true)
  pushEnabled         Boolean @default(true)
  trainingReminders   Boolean @default(true)
  tournamentReminders Boolean @default(true)
  requestApprovals    Boolean @default(true)
  financeUpdates      Boolean @default(true)
  aiInsightUpdates    Boolean @default(true)
  systemNotifications Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// A browser Web-Push subscription. One user may have several (one per device).
/// `endpoint` is the browser-issued URL; `p256dh`/`auth` are the client's public
/// encryption keys. Sending requires server-side VAPID keys — when those env vars
/// are unset, push self-disables and email/in-app delivery still work.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ═══════════════════════════════════════════════════════════════
// ANALYTICS DOMAIN (Stage 1) — additive. No existing table changes.
// Core workflow: profile → opponent → match → scouting → game plan
// → post-match → training plan. RAW COUNTS ONLY: percentages are
// computed at read time, never stored. Every report row carries the
// AI-report contract (status/model/promptVersion/sourceRecordIds/
// confidence) so generated vs approved vs outdated is first-class.
// ═══════════════════════════════════════════════════════════════

enum ReportStatus {
  generated
  approved
  rejected
  outdated
}

enum PlanTier {
  free
  player_pro
  coach_pro
  academy
}

// --- Extended player profile (1:1 with a "player" User) ─────────
// Style dimensions are 1..10, nullable until the coach/player sets them.
// A descriptive style classification is DERIVED from these, never stored
// as a single hard label. coachNotes live in PrivateCoachNote, NOT here,
// so they can never be selected into a player/parent response.
model PlayerProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  dateOfBirth            String? // ISO "yyyy-MM-dd"; age is derived
  playingLevel           String?
  ranking                String?
  dominantHand           String? // left | right
  backhandType           String? // one_handed | two_handed
  preferredSurface       String? // clay | hard | grass | indoor
  currentCoachId         String? // loose pointer (no FK) to a coach User
  preferredCourtPosition String?
  technicalStrengths     String[]
  technicalWeaknesses    String[]
  physicalStrengths      String[]
  physicalLimitations    String[]
  serveTendencies        String?
  returnTendencies       String?
  mentalUnderPressure    String?
  currentGoals           String?
  injuryRestrictions     String?
  // Playing-style dimensions (1..10)
  styleAggression        Int? // defensive(1)..aggressive(10)
  styleNetPlay           Int? // deep baseline(1)..frequent net(10)
  styleRallyTolerance    Int? // short-point pref(1)..long-rally(10)
  styleServeDependence   Int? // low(1)..high(10)
  styleRiskLevel         Int? // conservative(1)..high-risk(10)
  styleReturnPosition    Int? // inside-baseline(1)..deep(10)
  stylePressure          Int? // pressure performance 1..10
  suitClay               Int? // surface suitability 1..10
  suitHard               Int?
  suitGrass              Int?
  suitIndoor             Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation("UserProfile", fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_profiles")
}

// --- Private coach notes ────────────────────────────────────────
// Separate table so a note is NEVER joinable into a player/parent read.
// Server authorization must scope reads to the authoring coach only.
model PrivateCoachNote {
  id            String   @id @default(cuid())
  authorCoachId String
  subjectUserId String // the player the note is about
  opponentId    String? // optionally a note about an opponent
  body          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author  User @relation("CoachNoteAuthor", fields: [authorCoachId], references: [id], onDelete: Cascade)
  subject User @relation("CoachNoteSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  @@index([authorCoachId])
  @@index([subjectUserId])
  @@map("private_coach_notes")
}

// --- Reusable opponent scouting record ──────────────────────────
model Opponent {
  id                   String   @id @default(cuid())
  ownerId              String // coach/player who owns this record
  academyId            String? // loose pointer (tenancy added in Stage 2)
  firstName            String
  lastName             String
  dominantHand         String?
  backhandType         String?
  preferredSurface     String?
  strongestStroke      String?
  weakestStroke        String?
  servePatterns        String?
  returnPosition       String?
  returnTendencies     String?
  forehandPreference   String?
  backhandPreference   String?
  netBehaviour         String?
  pressurePerformance  String?
  styleAggression      Int?
  styleNetPlay         Int?
  styleRallyTolerance  Int?
  styleServeDependence Int?
  styleRiskLevel       Int?
  styleReturnPosition  Int?
  stylePressure        Int?
  observations         Json? // explicitly-marked coach observations
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  owner           User             @relation("OpponentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  matches         Match[]
  scoutingReports ScoutingReport[]
  gamePlans       GamePlan[]

  @@index([ownerId])
  @@map("opponents")
}

// --- Match recording (raw counts only) ──────────────────────────
model Match {
  id                   String   @id @default(cuid())
  playerId             String
  opponentId           String?
  academyId            String?
  date                 DateTime
  competition          String?
  surface              String // clay | hard | grass | indoor
  indoorOutdoor        String // indoor | outdoor
  format               String // best_of_3 | best_of_5 | pro_set | ...
  result               String? // win | loss — NEVER used to infer performance quality
  scoreSets            Json // [{ player: 6, opponent: 4, tiebreak?: "7-5" }]
  conditions           String?
  // ── raw counts (percentages computed on read) ──
  firstServeAttempts   Int?
  firstServesIn        Int?
  firstServePointsWon  Int?
  secondServePlayed    Int?
  secondServePointsWon Int?
  aces                 Int?
  doubleFaults         Int?
  returnPointsPlayed   Int?
  returnPointsWon      Int?
  winners              Int?
  forcedErrors         Int?
  unforcedErrors       Int?
  breakPointsCreated   Int?
  breakPointsConverted Int?
  breakPointsFaced     Int?
  breakPointsSaved     Int?
  netApproaches        Int?
  netPointsWon         Int?
  rallyLengthBuckets   Json? // { "1-4": n, "5-8": n, "9+": n }
  momentumChanges      Json? // [{ set, game, note }]
  notesBySet           Json? // { "1": "...", "2": "..." }
  createdBy            String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  player           User              @relation("MatchPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  opponent         Opponent?         @relation(fields: [opponentId], references: [id], onDelete: SetNull)
  postMatchReports PostMatchReport[]

  @@index([playerId])
  @@index([opponentId])
  @@index([date])
  @@index([createdBy])
  @@map("matches")
}

// --- Scouting report (opponent) ─────────────────────────────────
model ScoutingReport {
  id                String       @id @default(cuid())
  opponentId        String
  createdById       String
  academyId         String?
  content           Json // sections, each with evidence + confidence + dataSample
  status            ReportStatus @default(generated)
  model             String?
  promptVersion     String?
  sourceRecordIds   Json? // match ids the conclusions draw on
  confidenceOverall Float?
  approvedById      String?
  approvedAt        DateTime?
  generatedAt       DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  opponent  Opponent @relation(fields: [opponentId], references: [id], onDelete: Cascade)
  createdBy User     @relation("ScoutingCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([opponentId])
  @@index([createdById])
  @@map("scouting_reports")
}

// --- Pre-match game plan ────────────────────────────────────────
model GamePlan {
  id              String       @id @default(cuid())
  playerId        String
  opponentId      String?
  createdById     String
  academyId       String?
  content         Json // AI-suggested plan (priorities, serve/return/rally, planB, ...)
  coachOverrides  Json? // coach-approved edits — distinct from AI suggestions
  status          ReportStatus @default(generated)
  model           String?
  promptVersion   String?
  sourceRecordIds Json?
  approvedById    String?
  approvedAt      DateTime?
  generatedAt     DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  player    User      @relation("GamePlanPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  opponent  Opponent? @relation(fields: [opponentId], references: [id], onDelete: SetNull)
  createdBy User      @relation("GamePlanCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@index([opponentId])
  @@index([createdById])
  @@map("game_plans")
}

// --- Post-match analysis ────────────────────────────────────────
model PostMatchReport {
  id                String       @id @default(cuid())
  matchId           String
  createdById       String
  content           Json // reasons, per-set, baseline comparison, 3 conclusions, next-week priorities — each with confidence + evidence
  status            ReportStatus @default(generated)
  model             String?
  promptVersion     String?
  sourceRecordIds   Json?
  confidenceOverall Float?
  approvedById      String?
  approvedAt        DateTime?
  generatedAt       DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdBy User  @relation("PostMatchCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([matchId])
  @@index([createdById])
  @@map("post_match_reports")
}

// --- Training plan + measurable drills ──────────────────────────
model TrainingPlan {
  id             String       @id @default(cuid())
  playerId       String
  createdById    String
  sourceReportId String? // originating PostMatchReport (loose pointer)
  title          String
  weekOf         String?
  status         ReportStatus @default(generated)
  model          String?
  promptVersion  String?
  generatedAt    DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  player    User            @relation("TrainingPlanPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  createdBy User            @relation("TrainingPlanCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  drills    TrainingDrill[]

  generatedSessions GeneratedSession[] @relation("GeneratedSessionPlan")

  @@index([playerId])
  @@index([createdById])
  @@map("training_plans")
}

model TrainingDrill {
  id               String   @id @default(cuid())
  planId           String
  objective        String
  category         String // technical | tactical | physical | mental
  instructions     String
  durationMin      Int?
  reps             String? // e.g. "20 points"
  equipment        String?
  intensity        String? // low | medium | high
  successCriteria  String // measurable target
  relatedInsight   String?
  coachNotes       String?
  completionStatus String   @default("pending") // pending | done | skipped
  trainingId       String? // optional link to a scheduled Training (loose)
  // Provenance when this drill came out of the coaching library rather than
  // being typed by hand. SetNull, not Cascade: retiring a library drill must
  // never erase a plan a player already worked through.
  libraryDrillId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  plan         TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  libraryDrill Drill?       @relation("TrainingDrillLibrary", fields: [libraryDrillId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([libraryDrillId])
  @@map("training_drills")
}

// ── Coaching knowledge base (drill library) ──────────────────────
// The library is CONTENT, not user data: every row is imported from a
// reviewed YAML document under `content/drills/` (see docs/library.md).
// `id` is therefore the slug from that document — not a cuid — so the
// same drill keeps its identity across environments and re-imports, and
// `contentHash` makes a re-import of unchanged content a no-op.
model Drill {
  id          String @id // the slug from the YAML document, e.g. "serve-plus-one-deep-cross"
  version     Int    @default(1)
  status      String @default("draft") // draft | reviewed | approved | retired
  contentHash String // sha256 of the canonical JSON of the source document
  domain      String // technique | tactics | footwork | serve_return | physical | mental | warmup_cooldown | games_kids

  titleEn           String
  titleEs           String
  objectiveEn       String
  objectiveEs       String
  setupEn           String
  setupEs           String
  progressionEn     String
  progressionEs     String
  regressionEn      String
  regressionEs      String
  successCriteriaEn String
  successCriteriaEs String
  stepsEn           String[]
  stepsEs           String[]
  cuesEn            String[]
  cuesEs            String[]
  commonErrorsEn    String[]
  commonErrorsEs    String[]

  levelBands String[] // beginner | intermediate | advanced | high_performance
  ageBands   String[] // u10 | u12 | u14 | u16 | u18 | adult
  blockKinds String[] // warmup | technical | tactical | live | cooldown

  playersMin Int
  playersMax Int
  courtsMin  Float
  courtsMax  Float
  equipment  String[]

  defaults Json // { durationMin, reps, sets, restSec, intensity }
  ranges   Json // { durationMin: [lo, hi], reps: [lo, hi], sets: [lo, hi] }
  diagram  Json // { court, markers[], paths[] } in court metres — never an image

  // Safeguarding: strength work for under-14s is bodyweight only and must be
  // supervised by a qualified professional. The flag travels with the drill so
  // the assembler and the UI can refuse to place it unsupervised.
  requiresQualifiedSupervision Boolean @default(false)

  licence     String  @default("none")
  authorAgent String? // researcher | fullstack | db

  // Tenancy. "global" rows are the shared library; academies and individual
  // coaches may hold their own (or forked) drills without polluting it.
  visibility   String  @default("global") // global | academy | private
  academyId    String?
  ownerCoachId String?
  forkedFromId String?

  approvedById String? // the human who approved it in the app — never an agent
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  academy    Academy? @relation("DrillAcademy", fields: [academyId], references: [id], onDelete: SetNull)
  ownerCoach User?    @relation("DrillOwnerCoach", fields: [ownerCoachId], references: [id], onDelete: SetNull)
  forkedFrom Drill?   @relation("DrillFork", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks      Drill[]  @relation("DrillFork")

  sources        DrillSource[]
  tags           DrillTag[]
  reviews        DrillReview[]
  trainingDrills TrainingDrill[] @relation("TrainingDrillLibrary")

  @@index([status, visibility])
  @@index([domain])
  @@index([academyId])
  @@index([ownerCoachId])
  @@map("drills")
}

// Provenance. Every drill carries at least one citation; nothing in the
// library is published without saying where the idea is documented.
model DrillSource {
  id                 String    @id @default(cuid())
  drillId            String
  coachOrBody        String
  title              String
  medium             String // video | book | article | course | clip | conference | curriculum
  publisherOrChannel String?
  url                String?
  year               Int?
  timestamp          String?
  note               String?
  fetchedAt          DateTime?

  drill Drill @relation(fields: [drillId], references: [id], onDelete: Cascade)

  @@index([drillId])
  @@map("drill_sources")
}

// Skill / pattern tags, normalised out of the YAML taxonomy so the
// assembler can select on them without scanning JSON.
model DrillTag {
  id      String @id @default(cuid())
  drillId String
  kind    String // skill | pattern
  tag     String

  drill Drill @relation(fields: [drillId], references: [id], onDelete: Cascade)

  @@unique([drillId, kind, tag])
  @@index([kind, tag])
  @@map("drill_tags")
}

// The shape of a session: an ordered list of blocks with a share of the
// total time. Templates are data, so a coach can hold their own.
model SessionTemplate {
  id         String   @id @default(cuid())
  name       String
  levelBands String[]
  phase      String? // pre_season | in_season | taper | off_season
  blocks     Json // ordered [{ kind, sharePct, minMin, maxMin }]
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("session_templates")
}

// One assembled session proposal. `proposal` is what the assembler
// produced, `final` what the coach kept, `diff` what they changed —
// which is what the preference learner reads.
model GeneratedSession {
  id               String   @id @default(cuid())
  coachId          String
  playerId         String?
  teamId           String?
  constraints      Json
  proposal         Json
  final            Json?
  diff             Json?
  assemblerVersion String
  seed             String?
  aiGenerationId   String?
  trainingPlanId   String?
  status           String   @default("proposed") // proposed | saved | discarded
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  coach        User          @relation("GeneratedSessionCoach", fields: [coachId], references: [id], onDelete: Cascade)
  player       User?         @relation("GeneratedSessionPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  team         Team?         @relation("GeneratedSessionTeam", fields: [teamId], references: [id], onDelete: SetNull)
  trainingPlan TrainingPlan? @relation("GeneratedSessionPlan", fields: [trainingPlanId], references: [id], onDelete: SetNull)

  @@index([coachId, createdAt])
  @@index([playerId])
  @@map("generated_sessions")
}

// What this coach tends to keep or throw away. Written by the coach
// (explicit) or learned from an accepted session diff (system).
model CoachPreference {
  id                   String   @id @default(cuid())
  coachId              String
  kind                 String // favour_source | avoid_source | avoid_drill | favour_drill | intensity | duration | block_order
  key                  String
  weight               Float
  learnedFromSessionId String?
  createdBy            String // coach | system
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  coach User @relation("CoachPreferenceCoach", fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, kind, key])
  @@map("coach_preferences")
}

// The review trail for one version of a drill. An agent may only file a
// report; `humanDecision` is set by a person in the app.
model DrillReview {
  id                  String    @id @default(cuid())
  drillId             String
  version             Int
  reviewerAgentReport Json?
  humanDecision       String? // approved | returned
  decidedById         String?
  decidedAt           DateTime?
  reasons             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  drill Drill @relation(fields: [drillId], references: [id], onDelete: Cascade)

  @@index([drillId, createdAt])
  @@map("drill_reviews")
}

// --- AI generation audit + dedup ────────────────────────────────
// One row per generation attempt. inputHash powers "don't regenerate
// an identical report"; status/error capture provider failures.
model AiGeneration {
  id            String   @id @default(cuid())
  userId        String
  reportType    String // scouting | game_plan | post_match | training_plan
  reportId      String?
  provider      String // deterministic | anthropic | openai | ...
  model         String
  promptVersion String
  inputHash     String
  status        String // success | invalid_output | provider_error
  errorMessage  String?
  latencyMs     Int?
  createdAt     DateTime @default(now())

  user User @relation("AiGenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([inputHash])
  @@map("ai_generations")
}

// --- Subscription + AI usage (limits centralized in code config) ─
model Subscription {
  id          String    @id @default(cuid())
  ownerUserId String    @unique
  academyId   String?
  tier        PlanTier  @default(free)
  status      String    @default("active") // active | past_due | canceled
  periodStart DateTime  @default(now())
  periodEnd   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner User @relation("SubscriptionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model AiUsageCounter {
  id               String   @id @default(cuid())
  userId           String
  periodKey        String // "yyyy-MM"
  reportsGenerated Int      @default(0)
  updatedAt        DateTime @updatedAt

  user User @relation("AiUsageUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodKey])
  @@map("ai_usage_counters")
}

// ═══════════════════════════════════════════════════════════════
// ROLES & TENANCY (Stage 2) — additive. Maps the brief's four roles
// onto the existing role strings: observer = Parent/guardian,
// admin = Academy administrator. No role renamed. Server middleware
// (authz.ts) enforces role + assignment + guardianship + tenancy.
// ═══════════════════════════════════════════════════════════════

model Academy {
  id        String   @id @default(cuid())
  name      String
  branding  Json? // logo url / colors — Academy-tier white-labeling
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships AcademyMembership[]
  drills      Drill[]             @relation("DrillAcademy")

  @@map("academies")
}

model AcademyMembership {
  id        String   @id @default(cuid())
  academyId String
  userId    String
  role      String // role WITHIN the academy: admin | coach | player
  createdAt DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  user    User    @relation("AcademyMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([academyId, userId])
  @@index([userId])
  @@map("academy_memberships")
}

// A coach may manage a player only through an active assignment.
model CoachAssignment {
  id        String   @id @default(cuid())
  coachId   String
  playerId  String
  status    String   @default("active") // active | ended
  createdAt DateTime @default(now())

  coach  User @relation("AssignmentCoach", fields: [coachId], references: [id], onDelete: Cascade)
  player User @relation("AssignmentPlayer", fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([coachId, playerId])
  @@index([coachId])
  @@index([playerId])
  @@map("coach_assignments")
}

// A parent/guardian (observer role) may access a junior only through a
// consented guardianship. parentalConsent gates all junior data access.
model Guardianship {
  id              String    @id @default(cuid())
  guardianId      String
  juniorPlayerId  String
  parentalConsent Boolean   @default(false)
  consentAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  guardian User @relation("GuardianshipGuardian", fields: [guardianId], references: [id], onDelete: Cascade)
  junior   User @relation("GuardianshipJunior", fields: [juniorPlayerId], references: [id], onDelete: Cascade)

  @@unique([guardianId, juniorPlayerId])
  @@index([guardianId])
  @@index([juniorPlayerId])
  @@map("guardianships")
}

// ── Gear catalogue domain (additive) ──────────────────────────────
//
// PROVENANCE IS PART OF THE DATA MODEL, NOT A NICE-TO-HAVE.
// Every row carries `source`, `sourceUrl` and `lastVerifiedAt`. A spec number
// with no traceable origin is a guess wearing a lab coat, and a player who
// restrings at the wrong tension because of one has been actively harmed.
// `lastVerifiedAt` stays null until the source was actually retrieved and the
// numbers cross-checked — null is the honest default, never a timestamp
// stamped in by a seed for rows nobody looked at.
//
// SPECIFICATIONS ONLY. Manufacturer marketing copy and product photography are
// their copyright: we compile published numbers, we never copy descriptions or
// images, and we never scrape retailers. `imageUrl` therefore stays null unless
// an image is licensed (see the `licensed` column in the CSV import).
//
// See docs/catalogue.md for the CSV column spec and the AccessorySpec shape.
model EquipmentProduct {
  // Ids are cuid() for rows created through the API or the CSV import, but the
  // seed pins readable slugs (prod-wilson-pro-staff-97-v14) so demo data and
  // any fixture referencing it stay legible in a diff.
  id             String    @id @default(cuid())
  // SAME vocabulary as the frontend EquipmentItem.category (src/types):
  // racket | string | shoes | balls | accessories.
  // Sub-kinds of accessory (grip, dampener, bag, apparel, …) live in
  // AccessorySpec.attributes.kind rather than fragmenting this list, so the
  // player's own equipment list and the catalogue never disagree on a category.
  category       String
  brand          String
  model          String
  // "" (empty string), never null, when a product has no variant.
  // Postgres treats NULLs as DISTINCT in a unique index, so a nullable variant
  // would let ("Wilson","Pro Staff 97",NULL) be inserted an unlimited number of
  // times and the upsert-on-conflict the CSV import depends on would never
  // fire. The empty string is a real value and collides properly.
  variant        String    @default("")
  releaseYear    Int?
  msrpEur        Float?
  // Null unless the image is licensed for our use. Never populated from a
  // manufacturer or retailer page.
  imageUrl       String?
  // Where the numbers came from, and the page they came from.
  source         String
  sourceUrl      String
  // Set ONLY when the source was actually retrieved and cross-checked.
  lastVerifiedAt DateTime?
  // Soft-delete: a discontinued product stays readable so a player's existing
  // EquipmentItem / StringSetup links never dangle, but drops out of the
  // catalogue listing.
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  racketSpec    RacketSpec?
  stringSpec    StringSpec?
  shoeSpec      ShoeSpec?
  accessorySpec AccessorySpec?

  equipmentItems      EquipmentItem[] @relation("EquipmentItemProduct")
  stringSetupsAsMains StringSetup[]   @relation("StringSetupMains")
  stringSetupsAsCross StringSetup[]   @relation("StringSetupCrosses")

  @@unique([brand, model, variant])
  @@index([category, brand])
  @@map("equipment_products")
}

// Frame specifications. Both head-size units are stored rather than derived:
// manufacturers publish one or the other, and converting back and forth turns
// 97 in² into 96 in².
model RacketSpec {
  id        String @id @default(cuid())
  productId String @unique

  headSizeCm2             Int
  headSizeIn2             Int
  lengthCm                Float
  unstrungWeightG         Int
  strungWeightG           Int?
  balanceMm               Int
  balancePtsHL            Int?
  swingweight             Int?
  stiffnessRa             Int?
  // Beam width as published, e.g. "23/26/23" — a profile, not one number.
  beamMm                  String
  stringPatternMains      Int
  stringPatternCrosses    Int
  // The manufacturer's recommended range, in kg. Kilograms are the single
  // stored unit across this whole domain; pounds are derived on the client
  // (lbs = kg × 2.2046) so the two can never drift apart in the database.
  recommendedTensionMinKg Float
  recommendedTensionMaxKg Float
  composition             String?
  // Available grip sizes as published, e.g. ["L0","L1","L2","L3","L4"].
  gripSizes               String[]
  // beginner | intermediate | advanced | pro
  targetLevel             String

  product EquipmentProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("racket_specs")
}

// String specifications. The 1–10 ratings are the manufacturer's own published
// performance claims where they publish them — comparative marketing numbers,
// not measurements. docs/catalogue.md says so, and so must any UI showing them.
model StringSpec {
  id        String @id @default(cuid())
  productId String @unique

  // polyester | co_polyester | multifilament | synthetic_gut | natural_gut
  // | kevlar | hybrid_set
  material   String
  gaugeMm    Float
  // The label as sold ("16L", "1.25"), which does not always match the gauge.
  gaugeLabel String
  // round | hexagonal | pentagonal | octagonal | twisted | textured
  shape      String
  coating    String?
  colour     String?

  // 1–10, as published by the manufacturer.
  power              Int
  control            Int
  spin               Int
  comfort            Int
  durability         Int
  tensionMaintenance Int

  recommendedTensionMinKg Float
  recommendedTensionMaxKg Float
  hybridPartnerNote       String?

  product EquipmentProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("string_specs")
}

model ShoeSpec {
  id        String @id @default(cuid())
  productId String @unique

  // clay | hard | all_court | grass | carpet | indoor
  courtType              String
  weightG                Int
  dropMm                 Int?
  // narrow | standard | wide
  widthFit               String
  cushioning             String
  // low | medium | high
  stability              String
  // Months of outsole durability guaranteed by the manufacturer, where offered.
  outsoleGuaranteeMonths Int?
  sizesEu                String[]

  product EquipmentProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("shoe_specs")
}

// Balls and accessories. A grip, a dampener, a bag and a tin of balls share
// almost no vocabulary, so rather than a column each the payload is JSON with a
// documented shape per `kind` (docs/catalogue.md). `kind` is always present.
model AccessorySpec {
  id        String @id @default(cuid())
  productId String @unique

  attributes Json

  product EquipmentProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("accessory_specs")
}

// One stringing job on one frame. This is the record that makes gear advice
// possible at all: what was in the racket, at what tension, how long it lasted,
// and why it came out.
//
// Tension is stored in KILOGRAMS ONLY. Clients that display pounds convert on
// read (lbs = kg × 2.2046). Storing both units would guarantee they disagree.
model StringSetup {
  id           String @id @default(cuid())
  playerId     String
  // The specific frame in the player's bag, not the catalogue product — two
  // identical rackets can be strung differently on purpose.
  racketItemId String

  // The catalogue rows used, when the string is one we carry…
  mainsProductId    String?
  crossesProductId  String?
  // …and the free text the player typed when it is not. One of each pair is
  // expected, but neither is required: a player who does not know what is in
  // their racket still has a tension worth recording.
  mainsCustomName   String?
  crossesCustomName String?

  tensionMainsKg   Float
  // Null means "same as mains" — a single-tension job, which is most of them.
  tensionCrossesKg Float?
  prestretch       Boolean?

  strungAt     DateTime
  stringerName String?
  costEur      Float?
  // Hours actually played on this set. The honest input for "is it dead yet".
  hoursPlayed  Float?

  // Retirement. A null retiredAt means this is the current setup in that frame.
  retiredAt     DateTime?
  // broke | dead | switched | other
  retiredReason String?
  // 1–5, the player's own comfort verdict. Subjective on purpose, and to be
  // labelled as such wherever it is shown.
  comfortNote   Int?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player     User              @relation("StringSetupPlayer", fields: [playerId], references: [id], onDelete: Cascade)
  racketItem EquipmentItem     @relation("StringSetupRacket", fields: [racketItemId], references: [id], onDelete: Cascade)
  mains      EquipmentProduct? @relation("StringSetupMains", fields: [mainsProductId], references: [id], onDelete: SetNull)
  crosses    EquipmentProduct? @relation("StringSetupCrosses", fields: [crossesProductId], references: [id], onDelete: SetNull)

  @@index([playerId, strungAt])
  @@index([racketItemId])
  @@map("string_setups")
}

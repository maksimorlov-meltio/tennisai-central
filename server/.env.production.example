# Production backend env. Set these in the host's env store (Render dashboard) —
# never commit real values. Every line below is a placeholder.

NODE_ENV=production
PORT=4000

# ── Database ────────────────────────────────────────────────────
# Use a PERSISTENT Postgres. Render's free database is deleted after ~30 days,
# which would take a live beta's data with it. Neon and Supabase both have a
# free tier that does not expire; a paid Render instance works too.
# `?sslmode=require` is needed by all three.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/tennisai?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────
# REQUIRED: >= 32 chars, and not one of the known dev defaults — the server
# refuses to boot in production otherwise.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

# Exact deployed frontend origin, used for CORS. No trailing slash, no path.
# A mismatch here is the single most common cause of "works locally, every
# request fails in production".
APP_URL="https://your-frontend.vercel.app"

# ── Beta access ─────────────────────────────────────────────────
# Registration is OPEN — there is no invite-code gate — so the deployed URL is
# itself the access control. Share it accordingly.
#
# MAX_SIGNUPS caps self-service registration. Counts existing player/coach/
# observer accounts (admins are created out of band and do not use a seat).
# Leave blank for no cap.
MAX_SIGNUPS="50"

# ── Email ───────────────────────────────────────────────────────
# Real sending switches on only when BOTH Gmail values are set. Until then the
# server logs the email (including the verification link) instead of sending.
#
# Get an app password: Google Account > Security > 2-Step Verification must be
# ON > App passwords > Mail. Spaces in the 16-char value are fine.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM_NAME="TennisAI"

# Keep this ON for a real beta: it is what proves a signup owns the address it
# claimed. Only set "false" for a local no-email trial. With it on and no Gmail
# credentials configured, nobody can verify and therefore nobody can log in.
REQUIRE_EMAIL_VERIFICATION="true"

# ── Demo data ───────────────────────────────────────────────────
# The seed writes four demo accounts that share one password published in this
# repo, one of them an admin. It refuses to run when NODE_ENV=production unless
# this is exactly "true". Leave it unset so the beta database starts clean.
# SEED_ON_BOOT="false"

# ── Optional: AI features ───────────────────────────────────────
# Training advice and tournament match-prep analysis. Both stay switched off
# and say so in the UI until BOTH values are set; nothing else is affected.
# Tournament conditions (weather + ball physics) need NO key and work regardless.
# AI_API_KEY is a server-side secret and never reaches the browser.
AI_PROVIDER=""     # anthropic | openai
AI_API_KEY=""
AI_MODEL=""        # optional; defaults to a pinned model per provider

# ── Optional: live tournament feed ──────────────────────────────
# Unset = the curated static tournament snapshot is used.
FEED_API_URL=""
FEED_API_KEY=""

# ── Optional: Web Push ──────────────────────────────────────────
# Push self-disables when unset; email and in-app notifications keep working.
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

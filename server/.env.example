# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# PostgreSQL. For local dev, `docker compose up -d` starts one matching this URL.
DATABASE_URL="postgresql://tennisai:tennisai@localhost:5432/tennisai?schema=public"

# Auth. In production this MUST be a strong random string (>= 32 chars); the app
# refuses to boot with a default/short secret when NODE_ENV=production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="dev-only-insecure-secret-change-me"
JWT_EXPIRES_IN="1d"

# Email verification gate. Secure default is "true" (login requires a verified
# email). Set to "false" ONLY for a local trial with no email provider — new
# accounts are then created pre-verified and can log in immediately.
REQUIRE_EMAIL_VERIFICATION="true"

# URL of the frontend (used for CORS + links inside emails). No trailing slash.
APP_URL="http://localhost:5180"

# NOTE: signup is OPEN — there is no invite-code gate. Anyone who can reach the
# deployed app can create an account. The only registration limits are the role
# restrictions, the 16+/terms consents, and the rate limiter.

# ── Gmail (optional) ────────────────────────────────────
# When BOTH GMAIL_USER and GMAIL_APP_PASSWORD are set, a real welcome
# email is sent via Gmail on every new signup. Leave them blank to just
# log the email to the server console (no real send, no credentials needed).
#
# To enable real sending:
#   1. Turn on 2-Step Verification on the Gmail account.
#   2. Google Account > Security > App passwords > create one for "Mail".
#   3. Paste the 16-character password below (spaces are fine).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
MAIL_FROM_NAME="TennisAI"

# -- SMTP (optional; alternative to Gmail) ---------------
# Any provider: Resend, Brevo, Mailgun, Postmark, your own relay. Useful
# because Gmail refuses to issue an app password until 2-Step Verification is
# on for the whole Google account, which not every operator can do.
#
# SMTP_HOST alone switches this on. Gmail wins if both are configured.
# MAIL_FROM must be an address the provider has authorised for your domain --
# a From it does not recognise is rejected or lands in spam.
# SMTP_SECURE="true" is implicit TLS (port 465); port 587 uses STARTTLS and
# wants "false".
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""

# WITH NO TRANSPORT AT ALL, and REQUIRE_EMAIL_VERIFICATION left on, SIGNUP IS
# REFUSED (503) -- otherwise every new account is created locked, told to check
# an inbox nothing can reach. Password reset says it is unavailable rather than
# promising a link. `npm run reset-link -- someone@example.com` is the way back
# in for an individual account in the meantime.

# ── AI training advice (optional) ───────────────────────
# Powers "Suggest from history" in the coach's Create Training dialog:
# past sessions + coach reviews + player feedback go to an LLM, which
# proposes what to train next.
#
# BOTH AI_PROVIDER and AI_API_KEY must be set. With either missing the
# feature reports itself as unavailable in the UI — it never falls back
# to canned text presented as AI output.
#
# AI_API_KEY is a SERVER-SIDE SECRET. It is never returned by any
# endpoint and never reaches the browser. Do not commit a real key.
#
#   AI_PROVIDER   anthropic | openai
#   AI_MODEL      optional override; defaults to a pinned model per provider
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
